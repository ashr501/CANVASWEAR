              "type": "text",
              "id": "cw036",
              "content": "01",
              "fontFamily": "Outfit",
              "fontSize": 18,
              "fontWeight": "700",
              "fill": "#D43D24"
            },
            {
              "type": "text",
              "id": "cw037",
              "content": "着るものぜんぶ、キャンバス。",
              "fontFamily": "Zen Kaku Gothic New",
              "fontSize": 22,
              "fontWeight": "700",
              "fill": "#1F1B18",
              "textGrowth": "fixed-width",
              "width": 420
            },
            {
              "type": "text",
              "id": "cw038",
              "content": "採用。ブランド名の意味をそのまま言い切る。サイトのトップに使用中",
              "fontFamily": "Zen Kaku Gothic New",
              "fontSize": 13,
              "fontWeight": "400",
              "fill": "#62594F",
              "lineHeight": 1.7,
              "textGrowth": "fixed-width",
              "width": 540
            }
