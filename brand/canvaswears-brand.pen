              "fontWeight": "500",
              "fill": "#D43D24",
              "letterSpacing": 3.2
            },
            {
              "type": "text",
              "id": "cw05l",
              "content": "着るものぜんぶ、",
              "fontFamily": "Zen Kaku Gothic New",
              "fontSize": 56,
              "fontWeight": "900",
              "fill": "#FBF7F2",
              "lineHeight": 1.3
            },
            {
              "type": "text",
              "id": "cw05m",
              "content": "キャンバス。",
              "fontFamily": "Zen Kaku Gothic New",
              "fontSize": 56,
              "fontWeight": "900",
              "fill": "#D43D24",
              "lineHeight": 1.3
            },
            {
              "type": "text",
              "id": "cw05n",
              "content": "写真もイラストも、全面フルカラーの昇華プリントで。Tシャツからドレス、バッグまで、どんな柄でも1点からお作りします。",
              "fontFamily": "Zen Kaku Gothic New",
              "fontSize": 15,
              "fontWeight": "400",
              "fill": "#D8CEC2",
              "lineHeight": 1.9,
              "textGrowth": "fixed-width",
              "width": 560
