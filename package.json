{
  "name": "multi-brand-hydrogen",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "shopify hydrogen dev --codegen",
    "build": "shopify hydrogen build --codegen",
    "build:vercel": "remix vite:build --config vite.config.vercel.ts",
    "preview": "npm run build && shopify hydrogen preview",
    "lint": "eslint --no-eslintrc -c .eslintrc.cjs --ext .js,.ts,.jsx,.tsx .",
    "typecheck": "tsc --noEmit",
    "codegen": "shopify hydrogen codegen"
  },
  "dependencies": {
    "@remix-run/express": "^2.10.0",
    "@remix-run/node": "^2.10.0",
    "@remix-run/react": "^2.10.0",
    "@remix-run/server-runtime": "^2.10.0",
    "@shopify/hydrogen": "^2024.7.0",
    "@shopify/remix-oxygen": "^2.0.4",
    "aws4fetch": "^1.0.20",
    "clsx": "^2.1.1",
    "express": "^4.19.2",
    "graphql": "^16.9.0",
    "isbot": "^4.4.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@remix-run/dev": "^2.10.0",
    "@shopify/cli": "^3.68.0",
    "@shopify/hydrogen-codegen": "^0.3.2",
    "@shopify/mini-oxygen": "~3.0.3",
    "@shopify/oxygen-workers-types": "^4.1.4",
    "@types/express": "^4.17.25",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "autoprefixer": "^10.4.19",
    "postcss": "^8.4.40",
    "tailwindcss": "^3.4.7",
    "typescript": "^5.5.4",
    "vite": "^5.4.0",
