{
  "buildCommand": "npm run build:vercel",
  "outputDirectory": "dist/client",
  "framework": null,
  "rewrites": [{"source": "/(.*)", "destination": "/api/server"}],
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [
        {"key": "Cache-Control", "value": "public, max-age=31536000, immutable"}
      ]
    }
  ],
  "functions": {
    "api/server.ts": {"memory": 1024, "maxDuration": 30}
  }
}
