# ===================================
# マルチサイト Hydrogen - 環境変数設定
# ===================================
# 1つのShopifyストアを、BRAND_IDごとに別サイトとして配信する。
# サイトを増やすときは app/lib/brands.ts にブランドを足し、
# そのブランドの envPrefix に合わせて BRANDn_* を追加する。

# どのサイトとして動かすか (elegant-plus | avant-garde | bridal)
BRAND_ID=elegant-plus

# セッション
SESSION_SECRET=your-session-secret-here

# --- ブランド1: HAORI+ (プラスサイズ羽織物) ---
# ※同じShopifyストアを共有する場合は全ブランド同じ値でOK
BRAND1_STORE_DOMAIN=your-store.myshopify.com
BRAND1_STOREFRONT_API_TOKEN=your-storefront-api-token

# --- ブランド2: NOCT. (V系×Y2K) ---
BRAND2_STORE_DOMAIN=your-store.myshopify.com
BRAND2_STOREFRONT_API_TOKEN=your-storefront-api-token

# --- ブランド3: BRILLAR (ウェディングドレス・ブライダルアクセサリー) ---
BRAND3_STORE_DOMAIN=your-store.myshopify.com
BRAND3_STOREFRONT_API_TOKEN=your-storefront-api-token

# Storefrontクライアントが実際に使う接続先。
# BRANDn_* が未設定のときのフォールバックにもなる
PUBLIC_STORE_DOMAIN=${BRAND1_STORE_DOMAIN}
PUBLIC_STOREFRONT_API_TOKEN=${BRAND1_STOREFRONT_API_TOKEN}
PRIVATE_STOREFRONT_API_TOKEN=
PUBLIC_STOREFRONT_ID=
