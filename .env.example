# ===================================
# Multi-Brand Hydrogen - 環境変数設定
# ===================================

# ブランド選択 (elegant-plus | avant-garde)
BRAND_ID=elegant-plus

# セッション
SESSION_SECRET=your-session-secret-here

# --- ブランド1: エレガントプラス (プラスサイズ羽織物) ---
BRAND1_STORE_DOMAIN=elegant-plus-store.myshopify.com
BRAND1_STOREFRONT_API_TOKEN=your-brand1-api-token

# --- ブランド2: アバンギャルド (40代以上ビジュアル系) ---
BRAND2_STORE_DOMAIN=avant-garde-store.myshopify.com
BRAND2_STOREFRONT_API_TOKEN=your-brand2-api-token

# アクティブブランドの設定 (BRAND_IDに応じて切り替え)
PUBLIC_STORE_DOMAIN=${BRAND1_STORE_DOMAIN}
PUBLIC_STOREFRONT_API_TOKEN=${BRAND1_STOREFRONT_API_TOKEN}
PRIVATE_STOREFRONT_API_TOKEN=
PUBLIC_STOREFRONT_ID=
