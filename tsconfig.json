{
  "include": [
    "env.d.ts",
    "app/**/*.ts",
    "app/**/*.tsx",
    "server.ts",
    "vite.config.ts",
    "react-router.config.ts",
    "tailwind.config.ts",
    ".react-router/types/**/*"
  ],
  "compilerOptions": {
    "lib": [
      "DOM",
      "DOM.Iterable",
      "ES2022"
    ],
    "isolatedModules": true,
    "esModuleInterop": true,
    "jsx": "react-jsx",
    "module": "ES2022",
    "moduleResolution": "Bundler",
    "resolveJsonModule": true,
    "target": "ES2022",
    "strict": true,
    "allowJs": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "paths": {
      "~/*": [
        "./app/*"
      ]
    },
    "noEmit": true,
    "plugins": [
      {
        "name": "@shopify/hydrogen/ts-plugin"
      }
    ],
    "types": [
      "@shopify/oxygen-workers-types",
      "node",
      "react-router",
      "vite/client"
    ],
    "rootDirs": [
      ".",
      "./.react-router/types"
    ]
  }
}
